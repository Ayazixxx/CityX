<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders the Subversion-style city plan (World/Plan) to a PNG and prints statistics, with no Unity involved. The plan code is
    pure, so this links the very same files the game uses and answers in a second. See docs/SUBVERSION_CITY.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS8632;CS0169;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <Compile Include="..\..\CityX\Assets\CityX\World\Plan\*.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\BuildingSite.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\BuildingParams.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\ZoneKind.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\DeterministicRandom.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\GarageEntrances.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\SteppedSidewalks.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\StepStreets.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\PedestrianStreets.cs" />
    <Compile Include="..\..\CityX\Assets\CityX\World\OpenSpace.cs" />
  </ItemGroup>
</Project>
