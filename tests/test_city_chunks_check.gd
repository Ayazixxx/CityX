extends SceneTree
## Regression check for the procedural, streaming city: chunk generation
## must be deterministic (same seed -> identical result), the spawn chunk
## must always come out as a clear (buildingless) street, moving the
## tracked "player" position across chunk boundaries must load the new
## area and free chunks that fall outside the unload radius, and street
## chunks must carry the expected road/sidewalk/marking geometry (no
## building ever placed on one, straight segments get a center line,
## intersections get crosswalks instead).

const CityChunk = preload("res://city/city_chunk.gd")

var _city: Node3D
var _materials: Dictionary
var _ok := true

func _init():
	var CityScene: PackedScene = load("res://city/city.tscn")
	_city = CityScene.instantiate()
	get_root().add_child(_city)
	_materials = CityChunk.build_materials()
	# Checks below need the actual load state real, not just a few arbitrary
	# frames elapsed -- city.gd's own loading is no longer a single
	# synchronous _ready()-time call (see its own class comment on why: that
	# used to freeze the whole engine for several real seconds), it's spread
	# across many frames instead (in TWO stages now -- INITIAL_LOAD_RADIUS
	# first, then the rest of LOAD_RADIUS in the background, see city.gd's
	# own INITIAL_LOAD_RADIUS comment), so waiting on each stage's own real
	# completion signal is the only correct way to know it's actually done,
	# not a guess at "enough" frames (confirmed directly: even 20+ frames
	# wasn't remotely enough at this batch size for the original single-
	# stage 81-chunk area).
	_city.initial_load_ready.connect(_run_initial_checks)
	_city.full_load_ready.connect(_run_full_checks)

## Buildings and the one collidable ground slab are always StaticBody3D;
## every purely-visual overlay (road surface, lane markings) is a
## MeshInstance3D -- so counting StaticBody3D children distinguishes "has
## a building" from "just street furniture" regardless of how many
## cosmetic overlays a street chunk happens to carry.
func _count_static_bodies(node: Node) -> int:
	var count := 0
	for child in node.get_children():
		if child is StaticBody3D:
			count += 1
	return count

func _run_initial_checks() -> void:
	# 1. Initial load: a (2*INITIAL_LOAD_RADIUS+1)^2 area around the origin
	# should be generated by the time initial_load_ready fires -- NOT the
	# full (2*LOAD_RADIUS+1)^2 area (see city.gd's own INITIAL_LOAD_RADIUS
	# comment for why that split exists: the full 81-chunk area took long
	# enough to feel like a frozen loading screen even fully yielded, real
	# reported bug). The rest streams in afterward via
	# _load_remaining_area_async(), checked separately below.
	var expected_initial: int = int(pow(2 * _city.INITIAL_LOAD_RADIUS + 1, 2))
	if _city._loaded_chunks.size() != expected_initial:
		print("FAIL: expected ", expected_initial, " initially loaded chunks, got ", _city._loaded_chunks.size())
		_ok = false
	else:
		print("PASS: initial load area has ", expected_initial, " chunks")

	# 2. The origin (spawn) chunk must always be a clear street -- just its
	# ground StaticBody, no building.
	var origin_chunk: Node3D = _city._loaded_chunks[Vector2i.ZERO]
	if _count_static_bodies(origin_chunk) != 1:
		print("FAIL: origin chunk should have only its ground body, has ", _count_static_bodies(origin_chunk), " StaticBody3D children")
		_ok = false
	else:
		print("PASS: origin/spawn chunk is clear (no building)")

	# 3. Determinism: the same seed must produce the same building layout
	# every time (or the same "no building" outcome). (5, -3) is a lot
	# chunk under STREET_PERIOD=4 (posmod of both is 1), so this can
	# actually exercise the building-placement path, not just an empty lot.
	var lot_coord := Vector2i(5, -3)
	var seed_a: int = _city._chunk_seed(lot_coord)
	var chunk_a := CityChunk.generate_chunk(seed_a, lot_coord, _city.CHUNK_SIZE, _materials)
	var chunk_b := CityChunk.generate_chunk(seed_a, lot_coord, _city.CHUNK_SIZE, _materials)
	var same_child_count := chunk_a.get_child_count() == chunk_b.get_child_count()
	var same_geometry := true
	if same_child_count and chunk_a.get_child_count() > 1:
		var box_a: CollisionShape3D = chunk_a.get_child(1).get_child(1)
		var box_b: CollisionShape3D = chunk_b.get_child(1).get_child(1)
		var shape_a: BoxShape3D = box_a.shape
		var shape_b: BoxShape3D = box_b.shape
		same_geometry = shape_a.size.is_equal_approx(shape_b.size) and chunk_a.get_child(1).position.is_equal_approx(chunk_b.get_child(1).position)
	if same_child_count and same_geometry:
		print("PASS: same chunk seed reproduces identical content (", chunk_a.get_child_count(), " children)")
	else:
		print("FAIL: same chunk seed produced different content")
		_ok = false
	chunk_a.free()
	chunk_b.free()

	# 4. Two different coordinates should (almost certainly) not roll the
	# exact same seed -- sanity check the hash actually varies per chunk.
	var seed_c: int = _city._chunk_seed(Vector2i(5, -3))
	var seed_d: int = _city._chunk_seed(Vector2i(-3, 5))
	if seed_c == seed_d:
		print("FAIL: different chunk coordinates hashed to the same seed")
		_ok = false
	else:
		print("PASS: different chunk coordinates hash to different seeds")

## Fires once _load_remaining_area_async() finishes topping up the origin
## area to the full LOAD_RADIUS, well after _run_initial_checks() already
## ran on the smaller INITIAL_LOAD_RADIUS -- the player hasn't "moved" at
## all yet at this point (that's check 5 below, which runs AFTER this and
## deliberately mutates _loaded_chunks itself, so it has to come after this
## check, not before).
func _run_full_checks() -> void:
	var expected_full: int = int(pow(2 * _city.LOAD_RADIUS + 1, 2))
	if _city._loaded_chunks.size() != expected_full:
		print("FAIL: expected ", expected_full, " chunks once the background top-up finished, got ", _city._loaded_chunks.size())
		_ok = false
	else:
		print("PASS: background top-up fills the origin area out to the full LOAD_RADIUS (", expected_full, " chunks)")

	# 5. Simulate the player walking far away: chunks near the origin
	# outside UNLOAD_RADIUS should be freed, and a fresh area around the
	# new position should be loaded.
	var far := Vector2i(10, 10)
	_city._update_chunks(far)
	# Unloading is still immediate, but GENERATION is now queued and drained
	# a few chunks per frame (see city.gd's own STREAM_CHUNKS_PER_FRAME --
	# a real reported hitch: crossing one chunk boundary used to build a
	# whole 9-chunk row inside a single frame). So the newly-in-range area
	# only exists after the queue has actually been pumped, rather than the
	# instant _update_chunks returns.
	while not _city._pending_chunks.is_empty():
		_city._drain_pending_chunks()

	var still_has_far_origin_chunk: bool = _city._loaded_chunks.has(Vector2i.ZERO)
	if still_has_far_origin_chunk:
		print("FAIL: origin chunk was not unloaded after moving far away")
		_ok = false
	else:
		print("PASS: origin chunk unloaded once out of range")

	var all_within_range := true
	for coord in _city._loaded_chunks.keys():
		var d: Vector2i = coord - far
		if maxi(absi(d.x), absi(d.y)) > _city.UNLOAD_RADIUS:
			all_within_range = false
			print("FAIL: chunk ", coord, " is farther than UNLOAD_RADIUS from ", far)
	if all_within_range:
		print("PASS: every loaded chunk is within UNLOAD_RADIUS of the new position")
	else:
		_ok = false

	var expected_new_area: int = int(pow(2 * _city.LOAD_RADIUS + 1, 2))
	var loaded_near_new: int = 0
	for coord in _city._loaded_chunks.keys():
		var d: Vector2i = coord - far
		if maxi(absi(d.x), absi(d.y)) <= _city.LOAD_RADIUS:
			loaded_near_new += 1
	if loaded_near_new == expected_new_area:
		print("PASS: full load radius generated around the new position (", loaded_near_new, " chunks)")
	else:
		print("FAIL: expected ", expected_new_area, " chunks near the new position, found ", loaded_near_new)
		_ok = false

	# 6. Street/lot grid structure: every chunk on a street row or column
	# must come out with no building at all (regardless of seed), and the
	# origin must always be one of them.
	if not CityChunk.is_street_chunk(Vector2i.ZERO):
		print("FAIL: origin (0, 0) is not classified as a street chunk")
		_ok = false
	else:
		print("PASS: origin (0, 0) is a street chunk")

	var street_coords := [Vector2i(0, 7), Vector2i(4, -9), Vector2i(-8, 2), Vector2i(12, 12)]
	var streets_clear := true
	for coord in street_coords:
		if not CityChunk.is_street_chunk(coord):
			print("FAIL: test setup error, ", coord, " should be a street coordinate under STREET_PERIOD")
			streets_clear = false
			continue
		var street_seed: int = _city._chunk_seed(coord)
		var street_chunk := CityChunk.generate_chunk(street_seed, coord, _city.CHUNK_SIZE, _materials)
		if _count_static_bodies(street_chunk) != 1:
			print("FAIL: street chunk ", coord, " has a building (", _count_static_bodies(street_chunk), " StaticBody3D children)")
			streets_clear = false
		street_chunk.free()
	if streets_clear:
		print("PASS: every sampled street-row/column chunk came out clear")
	else:
		_ok = false

	# 7. A straight street segment (only one axis on the grid) should have
	# no building either, and should carry at least one MeshInstance3D
	# overlay (the road surface plus its center line) -- a rough sanity
	# check that street furniture is actually being generated, not just
	# that it's building-free.
	var straight_coord := Vector2i(1, 0) # x=1 not a multiple of 4, z=0 is -> straight east-west segment, not an intersection
	if CityChunk.is_street_chunk(straight_coord) and posmod(straight_coord.x, CityChunk.STREET_PERIOD) == 0 and posmod(straight_coord.y, CityChunk.STREET_PERIOD) == 0:
		print("FAIL: test setup error, (1, 0) should be a straight segment, not an intersection")
		_ok = false
	var straight_chunk := CityChunk.generate_chunk(_city._chunk_seed(straight_coord), straight_coord, _city.CHUNK_SIZE, _materials)
	var overlay_count := straight_chunk.get_child_count() - _count_static_bodies(straight_chunk)
	if overlay_count >= 3: # road surface + 2 center-line stripes, at minimum
		print("PASS: straight street segment carries road + center-line overlays (", overlay_count, " overlay nodes)")
	else:
		print("FAIL: straight street segment has too few overlay nodes (", overlay_count, ")")
		_ok = false
	straight_chunk.free()

	# 8. An intersection (both axes on the grid) should carry crosswalk
	# stripes on all 4 sides instead of a center line -- comfortably more
	# overlay nodes than a straight segment.
	var intersection_chunk := CityChunk.generate_chunk(_city._chunk_seed(Vector2i.ZERO), Vector2i.ZERO, _city.CHUNK_SIZE, _materials)
	var intersection_overlay_count := intersection_chunk.get_child_count() - _count_static_bodies(intersection_chunk)
	if intersection_overlay_count > overlay_count:
		print("PASS: intersection carries more overlay nodes than a straight segment (", intersection_overlay_count, " vs ", overlay_count, ")")
	else:
		print("FAIL: intersection didn't carry the expected crosswalk overlays (", intersection_overlay_count, " vs straight's ", overlay_count, ")")
		_ok = false
	intersection_chunk.free()

	print("OVERALL: ", "PASS" if _ok else "FAIL")
	quit(0 if _ok else 1)
