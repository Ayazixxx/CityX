# =============================================================
# Godot (the original build -- now the reference implementation
# being ported from; see PORT_PLAN.md)
# =============================================================
.godot/
.import/
export.cfg
export_presets.cfg

# The Godot editor binaries themselves - not project source, don't version large binaries
tools/Godot_*
tools/godot_*

# =============================================================
# Unity (CityX/)
#
# Everything here is GENERATED from Assets/ + Packages/ +
# ProjectSettings/ and is rebuilt on first open. Library/ alone
# is gigabytes and rewrites constantly -- committing it would
# make the repo unusable.
#
# NOT ignored, and must stay tracked: Assets/, Packages/,
# ProjectSettings/, and every .meta file. Unity stores asset
# GUIDs and import settings in .meta -- lose those and every
# reference in every scene breaks.
# =============================================================
CityX/Library/
CityX/Temp/
CityX/Obj/
CityX/obj/
CityX/Build/
CityX/Builds/
CityX/Logs/
CityX/UserSettings/
CityX/MemoryCaptures/
CityX/Recordings/

# Generated solution/project files -- regenerated by the editor
CityX/*.csproj
CityX/*.sln
CityX/*.slnx
CityX/*.userprefs
CityX/*.user
CityX/.vs/
CityX/.idea/

# Crash reports and asset store cruft
CityX/sysinfo.txt
CityX/crashlytics-build.properties
CityX/Assets/AssetStoreTools*

# Blender working files. The scripts next to them rebuild each one exactly (docs/OCTASLASH.md), and what the game plays is the exported JSON.
CityX/SourceArt/**/*.blend
CityX/SourceArt/**/*.blend1

# The player model exported for fitting clothes in Blender (PlayerModelExporter writes it on demand), and headless build logs.
/PlayerModel.obj
/Logs/

# Scratch comparison exports from debugging the mustang's mismatched wheel
# sizes. Unreferenced by any scene or script; the fix itself is baked into
# mustang.glb.
vehicles/models/mustang/_compare/

# =============================================================
# OS / editor cruft
# =============================================================
Thumbs.db
.DS_Store

# Local Claude Code settings (per-machine tool permissions)
.claude/

# Build output of the dotnet helper tools (tools/cityplan: plan renderer; tools/bodyshape: body-shape preview)
tools/*/bin/
tools/*/obj/

# Python caches (the Blender scripts under CityX/SourceArt and tools/)
__pycache__/
*.pyc
